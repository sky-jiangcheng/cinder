# Local user configuration overrides / 本地用户配置覆盖
.statistics.local

# Temporary files / 临时文件
*.tmp
*.swp
*.bak

# Built binaries (see scripts/build.sh) / 构建产物
# Anchored with "/" so they only match repo-root binaries; unanchored patterns
# also swallowed cmd/mcp/ and hid cmd/mcp/results.go from version control.
/cinder
/cinder-mcp
/cinder-review
/cinder-server
/repotory
/repotory-mcp
/repotory-server
/repotory-wiki-rehearse
/repotory-wiki-export
/git-dashboard
/mcp
/searchbench

# Wails build output / Wails 构建输出
build/bin/
build/darwin/

# Wails frontend dependency cache / Wails 前端依赖缓存
web/package.json.md5

# Database files / 数据库文件
*.db
*.db-shm
*.db-wal

# Node / Node 产物
web/node_modules/
web/dist/
web/dist-server/
ide/vscode/node_modules/
ide/vscode/out/

# Generated Wails JS bindings (regenerated by `wails build`; nothing in
# web/src imports them — the app calls window.go.app.App directly) / Wails
# 生成的前端绑定（wails build 时重新生成，web/src 未引用）
web/wailsjs/

# Generated icon assets / 图标产物（由 build/icon.svg 经 scripts/generate-icons.mjs 生成）
build/icons/
build/appicon.png
build/icon.icns
build/icon.iconset/

# Generated docs HTML (built from docs/**/*.md by scripts/build-docs.mjs)
docs/**/*.html

# AI tooling artifacts / AI 工具产物
.agents/
.claude/
.easyclaw/
.omo/
.trae-html-share-packages/
.workbuddy/
.zcode/
.zwork/

# Release artifacts / 发布产物
# Built by scripts/build-release-assets.sh; ~40MB of cross-compiled binaries.
# Regenerate per release rather than committing them. The MCP server has no
# build-time input beyond this repo, so nothing is lost.
assets/releases/

# 根目录游离的 npm 依赖（图标脚本等的临时安装，真正的依赖树在 web/node_modules）
/node_modules/

# 本地 GUI 扫描测试产物（截图 + 报告，纯本地复查用）
.tmp-ui-test/

# 本地 W3 编译演练产物（真库副本 + 演练工作区）
.w3-rehearsal/

# 本地检索标注预备产物（queryset 工作表 + 真库一次性副本 + 工具二进制，含用户笔记清单）
.annotation-prep/

# 标注集产物（queries.jsonl 的 relevant 是 project_notes.id，即用户笔记 id 映射，
# 与 .annotation-prep/ 同为本地标注中间物，不入版本库）
/queries.jsonl

# 本机 MCP 客户端注册（scripts/repotory-init 写入，含机器本地绝对路径）
.mcp.json
.cursor/
.vscode/mcp.json

# 本地 MCP 冒烟脚本（spawn 本机构建的 repotory-mcp，含机器本地路径，纯复查用）
scratch-ui-test/

# 本地 wiki 真库演练工作区（cmd/wiki-rehearse 的一次性副本指针，含机器本地 /tmp 路径）
# 证据 jsonl/json 按需 git add；演练工作区本身不入库。
# v21-rehearse 早于本规则，过去只靠 `*.db` 通配拦住 4MB 真库副本；已入库的 3 个证据文件
# 继续被跟踪（忽略规则不作用于已跟踪文件），新产生的副本与中间产物从这里起被拦住。
v21-rehearse/
v25-rehearse/

# Agent 会话工作目录（DB 副本 / 编译日志 / go 缓存 / 工具二进制，数百 MB，纯本地复现物，绝不入库）
.agnes/

# Playwright CLI 本地会话产物（浏览器快照 / console 日志 / 本地 config，纯本地复现物）
.playwright/
.playwright-cli/

# 本地 skill 包构建产物（由 skill/repotory/ 打成 .skill zip，纯本地复现物）
outputs/skill-repotory/

# 本地插件布局预览图（一次性截图，非巡检归档）
outputs/jetbrains-tlayout-preview-*.png
outputs/vscode-reader-preview-*.png
