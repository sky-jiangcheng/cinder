{
  "name": "repotory-vscode",
  "displayName": "Cinder Memory",
  "publisher": "sky-jiangcheng",
  "version": "2.33.4",
  "description": "The local-first memory layer for AI coding agents. Browse, search and hand off your local knowledge base without leaving the editor. One VSIX covers VS Code, Cursor and Windsurf.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repotory.loadContext",
        "title": "Cinder: Load Session Context"
      },
      {
        "command": "repotory.handoff",
        "title": "Cinder: Record Session Handoff"
      },
      {
        "command": "repotory.search",
        "title": "Cinder: Search Knowledge",
        "icon": {
          "light": "media/icon-search-light.svg",
          "dark": "media/icon-search-dark.svg"
        }
      },
      {
        "command": "repotory.ask",
        "title": "Cinder: Ask the Knowledge Base"
      },
      {
        "command": "repotory.searchWiki",
        "title": "Cinder: Search Approved Knowledge Pages"
      },
      {
        "command": "repotory.registerMcp",
        "title": "Cinder: Register MCP Server (repotory-init)"
      },
      {
        "command": "repotory.diagnose",
        "title": "Cinder: Setup & Diagnostics",
        "icon": {
          "light": "media/icon-setup-light.svg",
          "dark": "media/icon-setup-dark.svg"
        }
      },
      {
        "command": "repotory.setMcpPath",
        "title": "Cinder: Set repotory-mcp Path"
      },
      {
        "command": "repotory.openDesktop",
        "title": "Cinder: Open Desktop App",
        "icon": {
          "light": "media/icon-desktop-light.svg",
          "dark": "media/icon-desktop-dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "repotory.loadContext",
        "key": "ctrl+alt+r c",
        "mac": "ctrl+cmd+r c"
      },
      {
        "command": "repotory.handoff",
        "key": "ctrl+alt+r h",
        "mac": "ctrl+cmd+r h"
      },
      {
        "command": "repotory.search",
        "key": "ctrl+alt+r s",
        "mac": "ctrl+cmd+r s"
      }
    ],
    "configuration": {
      "title": "Cinder",
      "properties": {
        "repotory.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18765",
          "description": "Cinder headless service URL (repotory server)."
        },
        "repotory.mcpPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the repotory-mcp executable. Leave empty to auto-detect from PATH, Homebrew/Scoop directories and the extension storage. Set it from the Command Palette with \"Cinder: Set repotory-mcp Path\"."
        }
      }
    },
    "views": {
      "repotory-explorer": [
        {
          "id": "repotory.notesSearch",
          "name": "Cinder Chat",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repotory-explorer",
          "title": "Cinder",
          "icon": "media/repotory.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/sync-init.mjs",
    "sync-init": "node scripts/sync-init.mjs",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test out/__tests__/*.test.js",
    "preview:console": "tsc -p ./ && node scripts/preview-console.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky-jiangcheng/cinder.git"
  },
  "homepage": "https://github.com/sky-jiangcheng/cinder/tree/master/ide/vscode",
  "bugs": {
    "url": "https://github.com/sky-jiangcheng/cinder/issues"
  },
  "keywords": [
    "repotory",
    "knowledge base",
    "session context",
    "handoff",
    "notes",
    "search",
    "claude",
    "cursor",
    "windsurf",
    "mcp"
  ]
}
